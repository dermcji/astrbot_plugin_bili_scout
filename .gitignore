# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时数据：订阅目标、历史去重记录，属于使用者的私有数据，不入库
# 插件首次运行会自动创建该目录（main.py 里 mkdir(parents=True, exist_ok=True)）
data/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
node_modules/
node_modules.orig/

# 个人信息 / 凭据：运行时才会出现，但绝不该进仓库
# data/ 里保存的是使用者的私有数据（订阅的群号、已推视频记录、手动订阅的会话）
*.log
cookie*.json
cookies.txt
*sessdata*
*bili_jct*
.env
.env.*

# 本地数据库 / 缓存
*.db
*.sqlite
*.sqlite3

# 打包产物：zip 里可能夹带 data/
*.zip
*.tar.gz
*.apk

# 扫码登录图：等同于账号登录态
*qr*.png
qrcode*.png
